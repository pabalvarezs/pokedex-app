generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    String
  pokemonId Int
  name      String
  createdAt DateTime @default(now())

  @@unique([userId, pokemonId])
  @@map("favorites")
}
