generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  name         String
  role         String   @default("trainer")
  avatar       String   @default("https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/25.png")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    String
  pokemonId Int
  name      String
  createdAt DateTime @default(now())

  @@unique([userId, pokemonId])
  @@map("favorites")
}
