generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  name         String
  role         String   @default("trainer")
  avatar       String   @default("https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/25.png")
  email        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  passwordResets PasswordReset[]

  @@map("users")
}

/// Enlaces de recuperación de contraseña. Solo se guarda el hash del token.
model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  source    String    @default("self") // "self" (lo pidió el usuario) | "admin"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("password_resets")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    String
  pokemonId Int
  name      String
  createdAt DateTime @default(now())

  @@unique([userId, pokemonId])
  @@map("favorites")
}

/// Snapshot de una categoría del Centro de Datos. Una fila por categoría: el
/// dataset completo se guarda en `payload` y se precarga en memoria al arrancar.
model DataCenterSnapshot {
  id          Int      @id @default(autoincrement())
  category    String   @unique
  generatedAt DateTime
  payload     Json
  count       Int
  failed      Int      @default(0)
  refreshing  Boolean  @default(false)
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("data_center_snapshots")
}
