DATABASE_URL=postgresql://pokedex:pokedex@localhost:5432/pokedex?schema=public
PORT=5000
AUTH_SECRET=cambia-este-secreto-en-produccion
CORS_ORIGIN=http://localhost:5173

# URL pública del frontend: se usa para armar el enlace de recuperación.
APP_URL=http://localhost:5173

# Minutos de vigencia del enlace de recuperación (30 por defecto).
PASSWORD_RESET_TTL_MINUTES=30

# Envío de correos con Resend (opcional). Si no se configuran, el enlace
# de recuperación queda disponible en el panel de admin.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# EMAIL_FROM=PokeChile <no-reply@tudominio.cl>
